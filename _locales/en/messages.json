  "onboardingWelcomeTitle": { "message": "Welcome to GG Buddy" },
  "onboardingWelcomeBody": { "message": "GG Buddy finds PC game prices through the GG.deals API. Open this popup on a supported store page to see detected games, or explore the tabs below — this short tour shows you the essentials." },
  "onboardingStoresTitle": { "message": "Browse supported stores" },
  "onboardingStoresBody": { "message": "Visit Steam, Epic, GOG, Humble, and many other shops (see the readme for the full list). The extension scans the active tab: check the badge in the header and open the Detected tab for matches. A price bar can appear at the bottom of the page when the overlay is enabled in Settings." },
  "onboardingHubTitle": { "message": "Dashboard & Search" },
  "onboardingHubBody": { "message": "The Dashboard tab summarizes deals for games you care about. Use Search to look up any title or Steam App ID and pick a currency. Deal scores and sparklines help you judge how good a price is versus history." },
  "onboardingWishlistTitle": { "message": "Wishlist & alerts" },
  "onboardingWishlistBody": { "message": "Add games to your wishlist from store pages or search results. Set a target price and enable notifications in Settings to get Chrome alerts when the price drops. You can export your list to share or back it up as JSON." },
  "onboardingPrefsTitle": { "message": "Make it yours" },
  "onboardingPrefsBody": { "message": "In Settings: choose theme and accent, customize the on-page price bar (layout, theme, hidden sites), and use Official Stores Only to hide grey-market keyshops in the popup, overlay, and wishlist alerts. You can replay this tour anytime from Maintenance → Show welcome tour." }
}
